<div id="list" class="scrollspy">
  <a id="apflora-link" class="scrollspy-item" href="#apflora">apflora.ch</a>
  <a id="arteigenschaften-link" class="scrollspy-item" href="#arteigenschaften"
    >arteigenschaften.ch</a
  >
  <a id="vermehrung-link" class="scrollspy-item" href="#vermehrung"
    >vermehrung.ch</a
  >
  <a id="awel-personal-link" class="scrollspy-item" href="#awel-personal"
    >AWEL-Personal</a
  >
  <a id="kapla-link" class="scrollspy-item" href="#kapla">Kapla</a>
  <a id="awel-indikatoren-link" class="scrollspy-item" href="#awel-indikatoren"
    >AWEL-Indikatoren</a
