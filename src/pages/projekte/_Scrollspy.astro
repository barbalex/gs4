</div>

<style>
  .scrollspy {
    background-color: transparent;
    border: 1px solid var(--sidenav-border);
    margin-bottom: 15px !important;
    padding-left: 0;
    padding-right: 0;
    border-radius: 5px;
    list-style: none;
    height: fit-content;
    scroll-target-group: auto;
  }
  @media (min-width: 800px) {
    .scrollspy {
      position: sticky;
      top: 15px;
    }
  }

  .scrollspy-item {
    display: block;
    color: var(--sidenav-text);
    font-weight: bold;
    padding: 10px 15px;
    text-decoration: none;
    /* border: 0.3px solid rgba(0, 0, 0, 0.125); */
    &:target-current {
      background-color: var(--sidenav-active-bg);
      color: var(--text);
    }
  }

  .scrollspy-item:hover {
    background-color: var(--sidenav-hover-bg);
  }

  /* once scroll-target-group is supported, this can be removed */
  /* https://caniuse.com/?search=scroll-target-group */
  .scrollspy-item.active {
    background-color: var(--sidenav-active-bg);
    color: var(--text);
  }
  a {
    border-bottom: none;
  }
  a:hover {
    border-bottom: none;
  }
</style>
