{
  "name": "gs4",
  "description": "Gabriel Software's website",
  "type": "module",
  "version": "2.0.29",
  "author": "Alexander Gabriel",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "node scripts/deploy.mjs",
    "deploy_preview": "vercel build && vercel deploy --prebuilt",
    "deploy_productive": "vercel build --prod && vercel deploy --prebuilt --prod",
    "deploy_only": "vercel deploy --prebuilt --prod",
    "test": "npm run test:precache && NODE_ENV=dev playwright test",
    "test:precache": "astro build && node --test tests/sw-precache.test.mjs",
    "test-report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "how-to-install-using-sfw": "sfw npm install -f",
    "ncu using cooldown": "ncu -c 5 -i"
  },
  "dependencies": {
    "@iconify-json/ant-design": "1.2.9",
    "@iconify-json/bi": "1.2.7",
    "@iconify-json/fa-brands": "1.2.2",
    "@iconify-json/fa-regular": "1.2.2",
    "@iconify-json/fa-solid": "1.2.2",
    "@iconify-json/ic": "1.2.4",
    "@vercel/analytics": "2.0.1",
    "astro": "7.4.5",
    "astro-icon": "1.2.0",
    "leaflet": "1.9.4",
    "swiper": "12.2.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@vite-pwa/astro": "2.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "vercel": "65.10.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barbalex/gs4"
  },
  "overrides": {
    "tar": "7.5.22",
    "js-yaml": "4.3.2"
  }
}
